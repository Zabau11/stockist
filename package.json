{
  "name": "stockist",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @stockist/web",
    "build": "npm run build -w @stockist/web",
    "typecheck": "npm run typecheck -w @stockist/discovery && npm run typecheck -w @stockist/web"
  },
  "engines": {
    "node": ">=22"
  }
}
